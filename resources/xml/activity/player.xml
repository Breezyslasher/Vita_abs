<?xml version="1.0" encoding="utf-8"?>
<!--
    Player screen — direction A, "Split shelf".

    One frame for both content types: audiobooks and podcasts differ only in
    what fills the slots, never in layout. Left column is art + two stat
    tiles; right column is text, progress and transport.

    Sizes are borealis layout units (a 1280-wide logical canvas), which is
    what the rest of the XML in this repo uses.

    This screen keeps its own fixed palette rather than following the app
    theme: it is a full-screen playback surface, and the artwork needs a
    constant dark field to sit on.
-->
<brls:Box
    id="player/container"
    width="100%"
    height="100%"
    axis="row"
    alignItems="stretch"
    paddingTop="36"
    paddingBottom="36"
    paddingLeft="40"
    paddingRight="40"
    backgroundColor="#14161e">

    <!-- ── Left column: cover + stat tiles ───────────────────────────── -->
    <brls:Box
        width="300"
        axis="column"
        alignItems="stretch"
        marginRight="36">

        <brls:Image
            id="player/cover"
            width="300"
            height="300"
            scalingType="fit"
            cornerRadius="8"
            marginBottom="18"
            backgroundColor="#1e2230"/>

        <!-- Two stat tiles. Captions and values are rewritten per media
             type in PlayerActivity::updateInfoSlots(). -->
        <brls:Box
            axis="row"
            alignItems="stretch">

            <brls:Box
                grow="1"
                axis="column"
                marginRight="10"
                paddingTop="10"
                paddingBottom="10"
                paddingLeft="12"
                paddingRight="12"
                cornerRadius="6"
                borderThickness="1"
                borderColor="#2a2f3c"
                backgroundColor="#1c1f29">
                <brls:Label
                    text="SPEED"
                    fontSize="10"
                    textColor="#6f7488"
                    singleLine="true"/>
                <brls:Label
                    id="player/speedLabel"
                    text="1.0x"
                    fontSize="17"
                    textColor="#d79b5a"
                    marginTop="2"
                    singleLine="true"/>
            </brls:Box>

            <brls:Box
                grow="1"
                axis="column"
                paddingTop="10"
                paddingBottom="10"
                paddingLeft="12"
                paddingRight="12"
                cornerRadius="6"
                borderThickness="1"
                borderColor="#2a2f3c"
                backgroundColor="#1c1f29">
                <brls:Label
                    id="player/tileRightCaption"
                    text="CHAPTER"
                    fontSize="10"
                    textColor="#6f7488"
                    singleLine="true"/>
                <brls:Label
                    id="player/tileRightValue"
                    text="—"
                    fontSize="17"
                    textColor="#f0f1f5"
                    marginTop="2"
                    singleLine="true"/>
            </brls:Box>

        </brls:Box>

    </brls:Box>

    <!-- ── Right column: text, progress, transport ───────────────────── -->
    <brls:Box
        grow="1"
        axis="column"
        alignItems="stretch">

        <brls:Label
            id="player/eyebrow"
            text="NOW PLAYING"
            fontSize="11"
            textColor="#6f7488"
            marginBottom="14"
            singleLine="true"/>

        <!-- Two lines max, then ellipsis (see maxHeight). -->
        <brls:Label
            id="player/title"
            text="Now Playing"
            fontSize="34"
            textColor="#f0f1f5"
            maxHeight="88"
            marginBottom="8"/>

        <brls:Label
            id="player/author"
            text=""
            fontSize="18"
            textColor="#9298ab"
            marginBottom="6"
            singleLine="true"/>

        <brls:Label
            id="player/subtitle"
            text=""
            fontSize="15"
            textColor="#6f7488"
            singleLine="true"/>

        <brls:Rectangle
            height="1"
            color="#262a34"
            marginTop="22"
            marginBottom="20"/>

        <!-- Context slot. Exactly one of these is visible at a time:
             chapter line for books, description for podcasts. -->
        <brls:Label
            id="player/chapterInfo"
            text=""
            fontSize="17"
            textColor="#f0f1f5"
            marginBottom="20"
            singleLine="true"/>

        <brls:Label
            id="player/description"
            text=""
            fontSize="15"
            textColor="#9298ab"
            lineHeight="1.55"
            maxHeight="70"
            marginBottom="20"
            visibility="gone"/>

        <brls:Slider
            id="player/progress"
            width="100%"
            height="8"
            marginBottom="10"/>

        <brls:Box
            axis="row"
            justifyContent="spaceBetween"
            alignItems="center">
            <brls:Label
                id="player/timeElapsed"
                text="0:00"
                fontSize="14"
                textColor="#9298ab"
                singleLine="true"/>
            <brls:Label
                id="player/timeRemaining"
                text="-0:00"
                fontSize="14"
                textColor="#9298ab"
                singleLine="true"/>
        </brls:Box>

        <!-- Transport. Pill labels come from the configured seek interval,
             filled in by PlayerActivity::onContentAvailable(). -->
        <brls:Box
            id="player/controlButtons"
            axis="row"
            alignItems="center"
            marginTop="26">

            <brls:Button
                id="player/btnRewind"
                style="borderless"
                width="96"
                height="64"
                cornerRadius="8"
                backgroundColor="#1c1f29"
                marginRight="22">
                <brls:Label
                    id="player/rewindLabel"
                    text="-30"
                    fontSize="17"
                    textColor="#c8cdda"
                    horizontalAlign="center"
                    width="96"
                    singleLine="true"/>
            </brls:Button>

            <brls:Button
                id="player/btnPlayPause"
                style="borderless"
                width="88"
                height="88"
                cornerRadius="44"
                backgroundColor="#d79b5a"
                marginRight="22">
                <brls:Label
                    id="player/playPauseIcon"
                    text="||"
                    fontSize="26"
                    textColor="#14161e"
                    horizontalAlign="center"
                    width="88"/>
            </brls:Button>

            <brls:Button
                id="player/btnForward"
                style="borderless"
                width="96"
                height="64"
                cornerRadius="8"
                backgroundColor="#1c1f29">
                <brls:Label
                    id="player/forwardLabel"
                    text="+30"
                    fontSize="17"
                    textColor="#c8cdda"
                    horizontalAlign="center"
                    width="96"
                    singleLine="true"/>
            </brls:Button>

        </brls:Box>

        <!-- Absorbs the slack so the block above keeps a fixed vertical
             rhythm regardless of how tall the context slot ends up. No
             button-hint row: the controls are self-evident and the spec's
             hint line was dropped deliberately. -->
        <brls:Box grow="1"/>

    </brls:Box>

</brls:Box>
